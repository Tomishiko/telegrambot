{
    "Kestrel": {
        "Endpoints": {
            "Http": {
                "Url": "http://0.0.0.0:80"
            }
        }
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "PollingTimeout": 14,
    "Api": {
        "BaseUrl": "https://api.telegram.org",
        "BotToken": "YOUR_BOTTOKEN",
        "HookUrl": "YOUR_URL_FOR_WEBHOOK"
    }
}
